{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SupeRR Selector",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Rebuild rankings",
      "type": "debugpy",
      "request": "launch",
      "module": "analysis.build",
      "args": ["--data-dir", "data/raw"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
