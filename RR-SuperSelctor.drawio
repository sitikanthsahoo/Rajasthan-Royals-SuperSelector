        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% =========================\n    %% DATA SOURCES\n    %% =========================\n    subgraph INPUTS[\&quot;Data sources\&quot;]\n        CSV[\&quot;Raw cricket CSV files\&quot;]\n        PROFILES[\&quot;Player profiles JSON\&quot;]\n        LOGO[\&quot;RR logo and visual assets\&quot;]\n        REF[\&quot;Official/reference player images\&quot;]\n    end\n\n    %% =========================\n    %% ANALYSIS PIPELINE\n    %% =========================\n    subgraph PIPELINE[\&quot;Analysis and scoring pipeline\&quot;]\n        CLEAN[\&quot;Data cleaning and validation\&quot;]\n        FILTER[\&quot;Legal delivery and match filters\&quot;]\n        FEATURES[\&quot;Feature engineering\&quot;]\n        PRESSURE[\&quot;Pressure situation detection\&quot;]\n        BAT_SCORE[\&quot;Batter scoring model\&quot;]\n        BOWL_SCORE[\&quot;Bowler scoring model\&quot;]\n        RANK[\&quot;Top 10 ranking generation\&quot;]\n        EVIDENCE[\&quot;Evidence and methodology report\&quot;]\n    end\n\n    CSV --&gt; CLEAN\n    CLEAN --&gt; FILTER\n    FILTER --&gt; FEATURES\n    FEATURES --&gt; PRESSURE\n    PRESSURE --&gt; BAT_SCORE\n    PRESSURE --&gt; BOWL_SCORE\n    BAT_SCORE --&gt; RANK\n    BOWL_SCORE --&gt; RANK\n    RANK --&gt; EVIDENCE\n\n    PROFILES --&gt; FEATURES\n    PROFILES --&gt; EVIDENCE\n\n    %% =========================\n    %% GENERATED DATA\n    %% =========================\n    subgraph OUTPUTS[\&quot;Generated analysis outputs\&quot;]\n        RANKINGS[\&quot;Batter and bowler rankings\&quot;]\n        MATCHES[\&quot;Match explorer data\&quot;]\n        PLAYER_DATA[\&quot;Player intelligence data\&quot;]\n        SIM_DATA[\&quot;Simulation inputs and results\&quot;]\n        REPORT[\&quot;Methodology and PDF report\&quot;]\n        AUDIT[\&quot;Source and data audit\&quot;]\n    end\n\n    RANK --&gt; RANKINGS\n    FEATURES --&gt; MATCHES\n    FEATURES --&gt; PLAYER_DATA\n    PRESSURE --&gt; SIM_DATA\n    EVIDENCE --&gt; REPORT\n    EVIDENCE --&gt; AUDIT\n\n    %% =========================\n    %% WEB APPLICATION\n    %% =========================\n    subgraph WEB[\&quot;SupeRR Selector web application\&quot;]\n        APP[\&quot;app.js application shell\&quot;]\n        THEME[\&quot;Dark/light theme controller\&quot;]\n        NAV[\&quot;Floating glass navigation\&quot;]\n\n        subgraph PAGES[\&quot;Main pages\&quot;]\n            HOME[\&quot;Rankings dashboard\&quot;]\n            LAB[\&quot;Player lab\&quot;]\n            SIM[\&quot;Scenario simulator\&quot;]\n            MATCH[\&quot;Match explorer\&quot;]\n            METH[\&quot;Methodology\&quot;]\n        end\n\n        subgraph COMPONENTS[\&quot;UI components\&quot;]\n            KPI[\&quot;KPI cards\&quot;]\n            TABLE[\&quot;Ranking tables\&quot;]\n            PROFILE[\&quot;Player profile panel\&quot;]\n            CHARTS[\&quot;Performance charts\&quot;]\n            PRESSURE_VIEW[\&quot;Pressure performance view\&quot;]\n            WEAKNESS[\&quot;Strength and weakness analysis\&quot;]\n            COUNTRY[\&quot;Country and IPL eligibility flag\&quot;]\n            CONTROLS[\&quot;Filters and player selectors\&quot;]\n        end\n    end\n\n    RANKINGS --&gt; HOME\n    PLAYER_DATA --&gt; LAB\n    SIM_DATA --&gt; SIM\n    MATCHES --&gt; MATCH\n    REPORT --&gt; METH\n    AUDIT --&gt; METH\n\n    LOGO --&gt; APP\n    REF --&gt; PROFILE\n    THEME --&gt; APP\n    NAV --&gt; APP\n\n    APP --&gt; HOME\n    APP --&gt; LAB\n    APP --&gt; SIM\n    APP --&gt; MATCH\n    APP --&gt; METH\n\n    HOME --&gt; KPI\n    HOME --&gt; TABLE\n    HOME --&gt; CONTROLS\n\n    LAB --&gt; PROFILE\n    LAB --&gt; CHARTS\n    LAB --&gt; PRESSURE_VIEW\n    LAB --&gt; WEAKNESS\n    LAB --&gt; COUNTRY\n\n    SIM --&gt; CONTROLS\n    SIM --&gt; PRESSURE_VIEW\n    SIM --&gt; CHARTS\n\n    MATCH --&gt; TABLE\n    MATCH --&gt; CHARTS\n\n    %% =========================\n    %% USER WORKFLOW\n    %% =========================\n    subgraph USER_FLOW[\&quot;Selection workflow\&quot;]\n        USER[\&quot;RR analyst or selector\&quot;]\n        EXPLORE[\&quot;Explore rankings\&quot;]\n        SELECT[\&quot;Select a player\&quot;]\n        INSPECT[\&quot;Review player evidence\&quot;]\n        TEST[\&quot;Test match scenario\&quot;]\n        DECIDE[\&quot;Make shortlist decision\&quot;]\n        EXPORT[\&quot;Export top 10/report\&quot;]\n    end\n\n    USER --&gt; EXPLORE\n    EXPLORE --&gt; SELECT\n    SELECT --&gt; INSPECT\n    INSPECT --&gt; TEST\n    TEST --&gt; DECIDE\n    DECIDE --&gt; EXPORT\n\n    HOME --&gt; EXPLORE\n    LAB --&gt; INSPECT\n    SIM --&gt; TEST\n    METH --&gt; DECIDE\n\n    %% =========================\n    %% DEPLOYMENT\n    %% =========================\n    subgraph DELIVERY[\&quot;Development and deployment\&quot;]\n        LOCAL[\&quot;Run locally in VS Code\&quot;]\n        GIT[\&quot;GitHub repository\&quot;]\n        VERCEL[\&quot;Vercel static deployment\&quot;]\n        BROWSER[\&quot;Analyst browser\&quot;]\n    end\n\n    WEB --&gt; LOCAL\n    LOCAL --&gt; GIT\n    GIT --&gt; VERCEL\n    VERCEL --&gt; BROWSER\n\n    %% =========================\n    %% STYLING\n    %% =========================\n    classDef source fill:#18203b,stroke:#db6ab1,color:#ffffff\n    classDef process fill:#292344,stroke:#a78bfa,color:#ffffff\n    classDef output fill:#33243f,stroke:#f08ac7,color:#ffffff\n    classDef web fill:#20263f,stroke:#67d4b5,color:#ffffff\n    classDef user fill:#43244c,stroke:#f2a0d0,color:#ffffff\n    classDef deploy fill:#1f3440,stroke:#69c7e8,color:#ffffff\n\n    class CSV,PROFILES,LOGO,REF source\n    class CLEAN,FILTER,FEATURES,PRESSURE,BAT_SCORE,BOWL_SCORE,RANK,EVIDENCE process\n    class RANKINGS,MATCHES,PLAYER_DATA,SIM_DATA,REPORT,AUDIT output\n    class APP,THEME,NAV,HOME,LAB,SIM,MATCH,METH,KPI,TABLE,PROFILE,CHARTS,PRESSURE_VIEW,WEAKNESS,COUNTRY,CONTROLS web\n    class USER,EXPLORE,SELECT,INSPECT,TEST,DECIDE,EXPORT user\n    class LOCAL,GIT,VERCEL,BROWSER deploy&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="n_CAFl35iM1mQUuGPDk5-1">
